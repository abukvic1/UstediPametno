@using UstediPametno.Models
@model CiljStednje

@{
    ViewData["Title"] = "Izmijeni cilj štednje";
}

<h1>Izmijeni cilj štednje</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger">
            </div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Naziv" class="form-label">
                    Naziv cilja
                </label>

                <input asp-for="Naziv"
                       class="form-control" />

                <span asp-validation-for="Naziv"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="CiljaniIznos" class="form-label">
                    Ciljani iznos
                </label>

                <input asp-for="CiljaniIznos"
                       class="form-control" />

                <span asp-validation-for="CiljaniIznos"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="DatumZavrsetka" class="form-label">
                    Rok ostvarenja cilja
                </label>

                <input asp-for="DatumZavrsetka"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="DatumZavrsetka"
                      class="text-danger">
                </span>
            </div>

            <button type="submit" class="btn btn-primary">
                Sačuvaj
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Nazad
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}