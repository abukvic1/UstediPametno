@using UstediPametno.Models
@model FiksniTrosak

@{
    ViewData["Title"] = "Obriši fiksni trošak";
}

<h1>Obriši fiksni trošak</h1>

<div class="alert alert-warning">
    Jesi li sigurna da želiš obrisati ovaj fiksni trošak?
</div>

<dl class="row">
    <dt class="col-sm-3">
        Naziv
    </dt>

    <dd class="col-sm-9">
        @Model.Naziv
    </dd>

    <dt class="col-sm-3">
        Kategorija
    </dt>

    <dd class="col-sm-9">
        @Model.Kategorija
    </dd>

    <dt class="col-sm-3">
        Mjesečni iznos
    </dt>

    <dd class="col-sm-9">
        @Model.MjesecniIznos.ToString("N2") KM
    </dd>
</dl>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Obriši
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Odustani
    </a>
</form>